rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow reads/writes if the request is authenticated
    // and the user's gymId matches the document's gymId
    
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.gymId == resource.data.gymId;
      allow delete: if false;
    }
    
    match /gyms/{gymId} {
      // Only allow authenticated users
      allow read: if request.auth != null;
      allow write: if request.auth != null && hasRole('OWNER');
      
      // Members subcollection
      match /members/{memberId} {
        allow read: if request.auth != null && userBelongsToGym(gymId);
        allow create: if request.auth != null && userBelongsToGym(gymId);
        allow update: if request.auth != null && userBelongsToGym(gymId);
        allow delete: if request.auth != null && userBelongsToGym(gymId) && hasRole('OWNER');
      }
      
      // Memberships subcollection
      match /memberships/{membershipId} {
        allow read: if request.auth != null && userBelongsToGym(gymId);
        allow create: if request.auth != null && userBelongsToGym(gymId);
        allow update: if request.auth != null && userBelongsToGym(gymId);
        allow delete: if request.auth != null && userBelongsToGym(gymId) && hasRole('OWNER');
      }
      
      // Membership Plans subcollection
      match /membershipPlans/{planId} {
        allow read: if request.auth != null && userBelongsToGym(gymId);
        allow create: if request.auth != null && userBelongsToGym(gymId) && hasRole('OWNER');
        allow update: if request.auth != null && userBelongsToGym(gymId) && hasRole('OWNER');
        allow delete: if request.auth != null && userBelongsToGym(gymId) && hasRole('OWNER');
      }

      match /personalTrainingPlans/{planId} {
        allow read: if request.auth != null && userBelongsToGym(gymId);
        allow create: if request.auth != null && userBelongsToGym(gymId) && hasRole('OWNER') && request.resource.data.gymId == gymId;
        allow update: if request.auth != null && userBelongsToGym(gymId) && hasRole('OWNER') && resource.data.gymId == gymId && request.resource.data.gymId == gymId;
        allow delete: if false;
      }

      match /personalTrainingSubscriptions/{subscriptionId} {
        allow read: if request.auth != null && userBelongsToGym(gymId);
        allow create: if request.auth != null && userBelongsToGym(gymId) && request.resource.data.gymId == gymId;
        allow update: if request.auth != null && userBelongsToGym(gymId) && resource.data.gymId == gymId && request.resource.data.gymId == gymId;
        allow delete: if false;
      }
      
      // Attendance subcollection
      match /attendance/{attendanceId} {
        allow read: if request.auth != null && userBelongsToGym(gymId);
        allow create: if request.auth != null && userBelongsToGym(gymId);
        allow update: if request.auth != null && userBelongsToGym(gymId);
        allow delete: if request.auth != null && userBelongsToGym(gymId) && hasRole('OWNER');
      }
      
      // Payments subcollection
      match /payments/{paymentId} {
        allow read: if request.auth != null && userBelongsToGym(gymId);
        allow create: if request.auth != null && userBelongsToGym(gymId);
        allow update: if request.auth != null && userBelongsToGym(gymId);
        allow delete: if request.auth != null && userBelongsToGym(gymId) && hasRole('OWNER');
      }
      
      // Trainers subcollection
      match /trainers/{trainerId} {
        allow read: if request.auth != null && userBelongsToGym(gymId);
        allow create: if request.auth != null && userBelongsToGym(gymId) && hasRole('OWNER');
        allow update: if request.auth != null && userBelongsToGym(gymId) && hasRole('OWNER');
        allow delete: if request.auth != null && userBelongsToGym(gymId) && hasRole('OWNER');
      }
      
      // Settings subcollection
      match /settings/{settingId} {
        allow read: if request.auth != null && userBelongsToGym(gymId);
        allow write: if request.auth != null && userBelongsToGym(gymId) && hasRole('OWNER');
      }

      match /messageTemplates/{templateId} {
        allow read: if request.auth != null && userBelongsToGym(gymId);
        allow create: if request.auth != null
          && userBelongsToGym(gymId)
          && hasRole('OWNER')
          && request.resource.data.gymId == gymId;
        allow update: if request.auth != null
          && userBelongsToGym(gymId)
          && hasRole('OWNER')
          && resource.data.gymId == gymId
          && request.resource.data.gymId == gymId;
        allow delete: if false;
      }

      match /messageSettings/{settingId} {
        allow read: if request.auth != null && userBelongsToGym(gymId);
        allow create, update: if request.auth != null
          && userBelongsToGym(gymId)
          && hasRole('OWNER')
          && request.resource.data.gymId == gymId;
        allow delete: if false;
      }

      match /messageCampaigns/{campaignId} {
        allow read: if request.auth != null && userBelongsToGym(gymId);
        allow write: if false;
      }

      match /messageLogs/{messageId} {
        allow read: if request.auth != null && userBelongsToGym(gymId);
        allow write: if false;
      }
      
      // Daily Stats subcollection
      match /dailyStats/{date} {
        allow read: if request.auth != null && userBelongsToGym(gymId);
        allow write: if false; // Only for Cloud Functions
      }
    }
    
    // Helper functions
    function userBelongsToGym(gymId) {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc.data.gymId == gymId;
    }
    
    function hasRole(role) {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc.data.role == role;
    }
  }
}
