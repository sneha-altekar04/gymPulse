{
  "name": "gympulse-sync-agent",
  "version": "1.0.0",
  "description": "GymPulse Biometric Attendance Sync Agent for Windows",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win"
  },
  "author": "GymPulse",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "electron-store": "^8.1.0",
    "firebase": "^10.12.0",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0"
  },
  "build": {
    "appId": "com.gympulse.sync-agent",
    "productName": "GymPulse Sync Agent",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    },
    "files": [
      "src/**/*",
      "config/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      "config/**/*"
    ]
  }
}
